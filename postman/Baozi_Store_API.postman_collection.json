{
  "info": {
    "_postman_id": "3f4ab15a-5b9c-4bb5-88ac-0a9b03495d8f",
    "name": "Baozi Store API - Adauto Brenne",
    "description": "Colecao da atividade pratica de Desenvolvimento Web Back-End de Adauto Brenne Roberto Vieira Lira, RU 5048958.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080/api"},
    {"key": "clienteId", "value": "1"},
    {"key": "produtoId", "value": "1"},
    {"key": "pedidoId", "value": "1"}
  ],
  "item": [
    {
      "name": "1. Criar Cliente",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"nome\": \"AdautoBrenne5048958\",\n  \"clienteDesde\": \"2026-08-24\"\n}"},
        "url": "{{baseUrl}}/clientes"
      },
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('clienteId', pm.response.json().id);"]}}]
    },
    {
      "name": "2. Criar Produto",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Baozi Tradicional\",\n  \"preco\": 8.50,\n  \"estoque\": true\n}"},
        "url": "{{baseUrl}}/produtos"
      },
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('produtoId', pm.response.json().id);"]}}]
    },
    {
      "name": "3. Criar Pedido",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"produtoId\": {{produtoId}},\n  \"quantidade\": 6\n}"},
        "url": "{{baseUrl}}/pedidos"
      },
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('pedidoId', pm.response.json().id);"]}}]
    },
    {
      "name": "4. Listagens Gerais",
      "item": [
        {"name": "Listar Clientes", "request": {"method": "GET", "url": "{{baseUrl}}/clientes"}},
        {"name": "Listar Produtos", "request": {"method": "GET", "url": "{{baseUrl}}/produtos"}},
        {"name": "Listar Pedidos", "request": {"method": "GET", "url": "{{baseUrl}}/pedidos"}}
      ]
    },
    {
      "name": "5. Consultas por ID",
      "item": [
        {"name": "Consultar Cliente", "request": {"method": "GET", "url": "{{baseUrl}}/clientes/{{clienteId}}"}},
        {"name": "Consultar Produto", "request": {"method": "GET", "url": "{{baseUrl}}/produtos/{{produtoId}}"}},
        {"name": "Consultar Pedido", "request": {"method": "GET", "url": "{{baseUrl}}/pedidos/{{pedidoId}}"}}
      ]
    },
    {
      "name": "6. Atualizacoes Opcionais",
      "item": [
        {
          "name": "Atualizar Cliente",
          "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"nome\": \"AdautoBrenne5048958\",\n  \"clienteDesde\": \"2026-08-24\"\n}"}, "url": "{{baseUrl}}/clientes/{{clienteId}}"}
        },
        {
          "name": "Atualizar Produto",
          "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Baozi Tradicional\",\n  \"preco\": 8.50,\n  \"estoque\": true\n}"}, "url": "{{baseUrl}}/produtos/{{produtoId}}"}
        },
        {
          "name": "Atualizar Pedido",
          "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"produtoId\": {{produtoId}},\n  \"quantidade\": 6\n}"}, "url": "{{baseUrl}}/pedidos/{{pedidoId}}"}
        }
      ]
    },
    {
      "name": "7. Exclusoes - executar nesta ordem",
      "item": [
        {"name": "Apagar Pedido", "request": {"method": "DELETE", "url": "{{baseUrl}}/pedidos/{{pedidoId}}"}},
        {"name": "Apagar Produto", "request": {"method": "DELETE", "url": "{{baseUrl}}/produtos/{{produtoId}}"}},
        {"name": "Apagar Cliente", "request": {"method": "DELETE", "url": "{{baseUrl}}/clientes/{{clienteId}}"}}
      ]
    }
  ]
}
